--- !u!114 &610426440
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 610426439}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5db0ce54fa2f1f4f9c1d56307aac606, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 2010184911}
  speakerNameText: {fileID: 1517553831}
  dialogueText: {fileID: 71894667}
  characterImage: {fileID: 1549679977}
  cutsceneLines:
  - lineText: ...Peaberry!
    speakerName: ???
    voiceClip: {fileID: 8300000, guid: 9176aad9a00d92941a4ae6d4f8ac0593, type: 3}
  - lineText: ...?
    speakerName: Princess Peaberry
    voiceClip: {fileID: 8300000, guid: 488c230e5890bf54f9dc1c6ae11a4993, type: 3}
  - lineText: "Princess Peaberry, why must we fight like this? We\u2019ve been allies
      for years, comrades in arms- has our friendship reached its expiration date
      too?!"
    speakerName: General CrunchWorth
    voiceClip: {fileID: 8300000, guid: e338d22f75b1e0440955c8af3316ce60, type: 3}
  - lineText: "I know you\u2019ve lost many of your legumes, watching many of my
      breadren crumble to the mould\u2026anyone would feel the same\u2026"
    speakerName: General CrunchWorth
    voiceClip: {fileID: 8300000, guid: e338d22f75b1e0440955c8af3316ce60, type: 3}
  - lineText: "So won\u2019t you stop this madness before everyone\u2019s thrown
      into the bin?"
    speakerName: General CrunchWorth
    voiceClip: {fileID: 8300000, guid: e338d22f75b1e0440955c8af3316ce60, type: 3}
  - lineText: "Let\u2019s work in harmony like old times- beans and toast, let\u2019s
      figure out this mould outbreak, helping each other like we did in The Flour
      Crustsades\u2026"
    speakerName: General CrunchWorth
    voiceClip: {fileID: 8300000, guid: e338d22f75b1e0440955c8af3316ce60, type: 3}
  - lineText: "CrunchWorth\u2026I-"
    speakerName: Princess Peaberry
    voiceClip: {fileID: 8300000, guid: 488c230e5890bf54f9dc1c6ae11a4993, type: 3}
  - lineText: "Because you can\u2019t do anything by yourself, can\u2019t you? Always
      needing someone to rely on, buttering up to just anyone and ignoring your troops\u2019
      needs"
    speakerName: ???
    voiceClip: {fileID: 8300000, guid: 9176aad9a00d92941a4ae6d4f8ac0593, type: 3}
  - lineText: "\u2026Are you even fit to lead, Princess?"
    speakerName: ???
    voiceClip: {fileID: 8300000, guid: 9176aad9a00d92941a4ae6d4f8ac0593, type: 3}
  - lineText: W-what's going on-
    speakerName: Princess Peaberry
    voiceClip: {fileID: 8300000, guid: 488c230e5890bf54f9dc1c6ae11a4993, type: 3}
  - lineText: "Just hand over the secret sauce and no necessary jam will be spilt
      nor beans to mush \u2026"
    speakerName: ???
    voiceClip: {fileID: 8300000, guid: 9176aad9a00d92941a4ae6d4f8ac0593, type: 3}
  - lineText: "It doesn\u2019t seem like you have any use for it anyway, you\u2019ll
      be the only one with loss in this war with how you are\u2026"
    speakerName: ???
    voiceClip: {fileID: 8300000, guid: 9176aad9a00d92941a4ae6d4f8ac0593, type: 3}
  - lineText: "I knew it...why should I ever trust you\u2026"
    speakerName: Princess Peaberry
    voiceClip: {fileID: 8300000, guid: 488c230e5890bf54f9dc1c6ae11a4993, type: 3}
  - lineText: ...Peaberry?
    speakerName: General CrunchWorth
    voiceClip: {fileID: 8300000, guid: e338d22f75b1e0440955c8af3316ce60, type: 3}
  - lineText: "I won\u2019t let you get away with this, CrunchWorth, you\u2019re
      not getting our secret sauce- you\u2019re going toast!"
    speakerName: Princess Peaberry
    voiceClip: {fileID: 8300000, guid: 488c230e5890bf54f9dc1c6ae11a4993, type: 3}
  characterSprites:
  - {fileID: 21300000, guid: 8e206aba52e4e6f4b8fc1091fe22afe6, type: 3}
  - {fileID: 21300000, guid: 4985e79dbba01034481cb1d23b9c5654, type: 3}
  - {fileID: 21300000, guid: 3a16f3a19f8d3ce4983b7c8de2a49a0e, type: 3}
  audioSource: {fileID: 610426442}
